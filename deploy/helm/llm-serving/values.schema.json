{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "backend",
    "model",
    "engine",
    "modelCache",
    "resources",
    "service"
  ],
  "properties": {
    "backend": {
      "type": "string",
      "enum": [
        "vllm",
        "triton"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "servedName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full commit SHA, so the benchmarked weights are reproducible."
        },
        "servedName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "dtype",
        "maxModelLen",
        "maxNumSeqs",
        "maxNumBatchedTokens",
        "kvCacheBytes",
        "prefixCaching",
        "chunkedPrefill",
        "cudaGraphs",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "type": "string",
          "enum": [
            "auto",
            "bfloat16",
            "float16"
          ]
        },
        "maxModelLen": {
          "type": "integer",
          "minimum": 128
        },
        "maxNumSeqs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxNumBatchedTokens": {
          "type": "integer",
          "minimum": 128
        },
        "kvCacheBytes": {
          "type": "integer",
          "minimum": 268435456
        },
        "prefixCaching": {
          "type": "boolean"
        },
        "chunkedPrefill": {
          "type": "boolean"
        },
        "cudaGraphs": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modelCache": {
      "type": "object",
      "required": [
        "claimName",
        "mountPath"
      ],
      "properties": {
        "claimName": {
          "type": "string",
          "minLength": 1
        },
        "create": {
          "type": "boolean"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "offline": {
          "type": "boolean"
        }
      }
    },
    "hfToken": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "required": [
            "nvidia.com/gpu",
            "memory"
          ],
          "properties": {
            "nvidia.com/gpu": {
              "type": "integer",
              "const": 1
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "httpPort"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "loadgen": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
